# Токен від @BotFather
BOT_TOKEN=123456:ABC-your-token

# PostgreSQL (база створюється на пристрої окремо)
DATABASE_URL=postgres://awana:awana@localhost:5434/awana

# Порт API
PORT=3000

# Публічна адреса сайту — бот покаже кнопку «Відкрити сайт» (localhost не підходить)
PUBLIC_URL=https://awana.turuta.pp.ua

# Необов'язково: папка зі зібраним фронтендом — тоді бек віддає і сайт (../frontend/dist)
STATIC_DIR=

# Необов'язково: якщо фронтенд на іншому домені — його адреса для CORS
CORS_ORIGIN=
